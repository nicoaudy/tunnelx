# Domain for subdomains (defaults to tunnel.yourdomain.com in production)
# DOMAIN=yourdomain.com

# Server port (defaults to 443 in production, 8080 local)
# SERVER_PORT=443

# Server WebSocket URL (defaults to wss://tunnel.yourdomain.com in production)
# SERVER_URL=wss://tunnel.yourdomain.com

# Set to true for local testing (HTTP, localhost)
LOCAL=false

# Tunnel timeout in minutes
FREE_TIMEOUT_MINUTES=15
PREMIUM_TIMEOUT_MINUTES=60